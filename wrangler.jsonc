{
 "name": "bollybrawl",
 "main": "cloudflare/site-worker.js",
 "compatibility_date": "2026-11-01",
 "build": {"command": "node build.mjs"},
 "assets": {
  "directory": "./dist",
  "binding": "ASSETS",
  "run_worker_first": ["/api/*"]
 },
 "durable_objects": {"bindings": [{"name":"ROOMS","class_name":"BollyRoom"}]},
 "migrations": [{"tag":"v1","new_sqlite_classes":["BollyRoom"]}]
}
