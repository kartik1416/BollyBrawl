{
  "name": "bollybrawl",
  "main": "cloudflare/site-worker.js",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "node build.mjs"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "BollyRoom"
      },
      {
        "name": "CONTENT",
        "class_name": "SiteContent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BollyRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "SiteContent"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "aajabhidle.com",
      "custom_domain": true
    },
    {
      "pattern": "www.aajabhidle.com",
      "custom_domain": true
    }
  ]
}
